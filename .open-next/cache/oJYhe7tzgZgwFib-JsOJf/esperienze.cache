\",\"className\":\"grid grid-cols-1 gap-0 bg-sol-mist md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"order-2 relative min-h-[400px] overflow-hidden md:order-2\",\"children\":[\"$\",\"$L3\",null,{\"src\":\"/images/services/colazione.jpg\",\"alt\":\"Colazione con prodotti locali al Relais Del Sol\",\"fill\":true,\"className\":\"object-cover\"}]}],[\"$\",\"div\",null,{\"className\":\"order-1 flex flex-col justify-center p-10 md:p-14\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-sans text-xs uppercase tracking-widest text-sol-olive\",\"children\":\"Ogni mattina\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 font-serif text-3xl text-sol-bark\",\"children\":\"La colazione del Relais\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\",\"children\":\"Nella splendida veranda affacciata sulla casa padronale, con vista sul lago di Garda, ogni mattina il buffet si riempie di prodotti italiani: dolci fatti in casa, mieli, marmellate, uova, affettati, frutta fresca, yogurt, prodotti dell'acetaia. E poi caffe, cappuccino, succhi, te. La colazione e inclusa nel soggiorno - ma la vista non ha prezzo.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 grid grid-cols-2 gap-4\",\"children\":[[\"$\",\"div\",\"Orario buffet\",{\"className\":\"bg-sol-sand p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\",\"children\":\"Orario buffet\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 font-sans text-sm text-sol-bark\",\"children\":\"8:00 – 10:00\"}]]}],[\"$\",\"div\",\"Prodotti\",{\"className\":\"bg-sol-sand p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\",\"children\":\"Prodotti\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 font-sans text-sm text-sol-bark\",\"children\":\"Freschi e locali\"}]]}],[\"$\",\"div\",\"Senza glutine\",{\"className\":\"bg-sol-sand p-4\",\"children\":[[\"$\",\"