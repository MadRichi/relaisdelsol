{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/esperienze/layout,_N_T_/esperienze/page,_N_T_/esperienze"},"segmentPaths":["/_tree","/_full","/esperienze/__PAGE__","/esperienze","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"it\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=3840&amp;q=75 3840w\" imageSizes=\"100vw\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0bh8m..b~jckt.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0eqaxem3qj85e.js\"/><script src=\"/_next/static/chunks/0t~alnn~v6duj.js\" async=\"\"></script><script src=\"/_next/static/chunks/0.~ylj4ir16c3.js\" async=\"\"></script><script src=\"/_next/static/chunks/11i0b5~1.z993.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0.yhn5h0n6614.js\" async=\"\"></script><script src=\"/_next/static/chunks/0scs0g9f1_sv4.js\" async=\"\"></script><script src=\"/_next/static/chunks/0eewamb49pw7k.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ps5_aybo7288.js\" async=\"\"></script><script src=\"/_next/static/chunks/01_6tc.iwr~66.js\" async=\"\"></script><title>Esperienze | Relais Del Sol — Lazise, Lago di Garda</title><meta name=\"description\" content=\"Scopri le esperienze del Relais Del Sol: parco con piscina a sfioro, colazione con prodotti locali, eventi privati e tutto il territorio del Lago di Garda.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0u1vv8138-u_h.ico\" sizes=\"1206x1243\" type=\"image/x-icon\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LodgingBusiness\",\"name\":\"Agriturismo Relais del Sol\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Loc. Casa Antonia, 1\",\"addressLocality\":\"Pacengo di Lazise\",\"addressRegion\":\"VR\",\"postalCode\":\"37017\",\"addressCountry\":\"IT\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":45.5083,\"longitude\":10.7378},\"telephone\":\"+390456490008\",\"priceRange\":\"€€\",\"amenityFeature\":[\"Pool\",\"Breakfast\",\"WiFi\",\"Dog Friendly\",\"Lake View\"]}</script><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"bg-sol-cream text-sol-bark antialiased overflow-x-hidden\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-300\"><div class=\"mx-auto flex h-20 max-w-7xl items-center px-4 md:px-8\"><div class=\"w-10 md:hidden\"></div><a class=\"flex flex-1 items-center justify-center gap-2 transition-all duration-300 md:flex-none md:justify-start\" href=\"/\"><img alt=\"Relais Del Sol\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75\"/><span class=\"font-serif text-2xl italic text-sol-cream\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\">Relais Del Sol</span></a><nav class=\"ml-10 hidden items-center gap-7 md:flex\"><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/camere\">Camere</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/agricamping\">Agriglamping</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/esperienze\">Esperienze</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/prodotti\">Prodotti</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/chi-siamo\">Chi Siamo</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/contatti\">Contatti</a></nav><div class=\"ml-auto hidden md:block\"><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-sol-terracotta text-white border border-sol-terracotta hover:bg-sol-terracotta/90 h-9 px-4\" variant=\"primary\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota Ora</a></div><button type=\"button\" class=\"ml-auto inline-flex h-10 w-10 items-center justify-center md:hidden text-sol-cream\" aria-label=\"Apri menu\" aria-expanded=\"false\"><span class=\"sr-only\">Apri menu</span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M4 7H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M4 12H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M4 17H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path></svg></button></div></header><main><section class=\"relative h-[60vh] min-h-[400px] overflow-hidden\"><img alt=\"Esperienze tra piscina, parco e Lago di Garda\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fesperienze-hero.jpg&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-b from-transparent to-sol-bark/70\"></div><div class=\"absolute bottom-12 left-6 md:left-16\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\"><span class=\"text-sol-cream\">Cosa ti aspetta</span></span><h1 class=\"mt-3 font-serif text-5xl font-light text-sol-cream md:text-6xl\">Esperienze</h1><p class=\"mt-2 max-w-lg font-sans text-base text-sol-cream/80\">Dal parco con piscina al borgo medievale di Lazise. Dalla colazione con i prodotti della terra al tramonto sul lago.</p></div></section><section class=\"bg-sol-cream py-24 md:py-32\"><div class=\"mx-auto max-w-7xl px-6 md:px-16\"><div class=\"mx-auto mb-20 max-w-2xl text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Al Relais Del Sol</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">Le esperienze che ti aspettano qui</h2></div><div class=\"flex flex-col gap-24\"><article id=\"piscina\" class=\"grid grid-cols-1 gap-0 bg-sol-mist md:grid-cols-2\"><div class=\"min-h-[400px]\"><div class=\"relative w-full overflow-hidden aspect-[4/3] md:aspect-auto md:h-full\"><div class=\"absolute inset-0 transition-opacity duration-700 opacity-100\"><img alt=\"Piscina a sfioro del Relais Del Sol\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 transition-opacity duration-700 opacity-0\"><img alt=\"Parco verde del Relais Del Sol\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina-2.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 transition-opacity duration-700 opacity-0\"><img alt=\"Area relax bordo piscina\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina-3.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 transition-opacity duration-700 opacity-0\"><img alt=\"Campi sportivi del Relais Del Sol\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina-4.jpg&amp;w=3840&amp;q=75\"/></div><button type=\"button\" aria-label=\"Immagine precedente\" class=\"absolute left-3 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 cursor-pointer items-center justify-center bg-black/30 transition-colors hover:bg-black/50\"><svg class=\"h-4 w-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M15 6L9 12L15 18\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-label=\"Immagine successiva\" class=\"absolute right-3 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 cursor-pointer items-center justify-center bg-black/30 transition-colors hover:bg-black/50\"><svg class=\"h-4 w-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M9 6L15 12L9 18\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><div class=\"absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 items-center gap-1.5\"><button type=\"button\" aria-label=\"Vai all&#x27;immagine 1\" class=\"h-1.5 rounded-full transition-all duration-300 w-3 bg-white\"></button><button type=\"button\" aria-label=\"Vai all&#x27;immagine 2\" class=\"h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/50\"></button><button type=\"button\" aria-label=\"Vai all&#x27;immagine 3\" class=\"h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/50\"></button><button type=\"button\" aria-label=\"Vai all&#x27;immagine 4\" class=\"h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/50\"></button></div></div></div><div class=\"flex flex-col justify-center p-10 md:p-14\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Relax</span><h3 class=\"mt-3 font-serif text-3xl text-sol-bark\">Parco e piscina a sfioro</h3><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Un enorme parco con secolari cedri, abeti, pini marittimi e magnolie che raggiungono quasi i 20 metri di altezza circonda il Relais. Al centro, la piscina a sfioro rivestita in mosaico Bisazza, con getti idromassaggio e sdraio per ogni camera. Si trovano inoltre un&#x27;area giochi attrezzata per i bambini e campi da calcio e pallavolo. Un posto dove il pomeriggio non ha fretta.</p><div class=\"mt-6 grid grid-cols-2 gap-4\"><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Orario piscina</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">10:00 - 19:00</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Lettini</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Inclusi con ogni camera</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Chiosco bordo piscina</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">10:00 - 19:00</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Campi sportivi</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Calcio e pallavolo</p></div></div><p class=\"mt-4 font-sans text-xs italic text-sol-bark/50\">Al chiosco: vino, olio, birra, panini, pizza, gelati e bibite.</p></div></article><article id=\"colazione\" class=\"grid grid-cols-1 gap-0 bg-sol-mist md:grid-cols-2\"><div class=\"order-2 relative min-h-[400px] overflow-hidden md:order-2\"><img alt=\"Colazione con prodotti locali al Relais Del Sol\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"order-1 flex flex-col justify-center p-10 md:p-14\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Ogni mattina</span><h3 class=\"mt-3 font-serif text-3xl text-sol-bark\">La colazione del Relais</h3><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Nella splendida veranda affacciata sulla casa padronale, con vista sul lago di Garda, ogni mattina il buffet si riempie di prodotti italiani: dolci fatti in casa, mieli, marmellate, uova, affettati, frutta fresca, yogurt, prodotti dell&#x27;acetaia. E poi caffe, cappuccino, succhi, te. La colazione e inclusa nel soggiorno - ma la vista non ha prezzo.</p><div class=\"mt-6 grid grid-cols-2 gap-4\"><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Orario buffet</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">8:00 – 10:00</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Prodotti</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Freschi e locali</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Senza glutine</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Disponibile</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Senza lattosio</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Disponibile</p></div></div><p class=\"mt-4 font-sans text-xs italic text-sol-bark/50\">Prodotti senza glutine e latte vegetale disponibili su richiesta.</p></div></article><article id=\"eventi\" class=\"grid grid-cols-1 gap-0 bg-sol-mist md:grid-cols-2\"><div class=\"min-h-[400px]\"><div class=\"relative w-full overflow-hidden aspect-[4/3] md:aspect-auto md:h-full\"><div class=\"absolute inset-0 transition-opacity duration-700 opacity-100\"><img alt=\"Evento privato al Relais Del Sol\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 transition-opacity duration-700 opacity-0\"><img alt=\"Matrimonio al Relais Del Sol\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Feventi-2.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 transition-opacity duration-700 opacity-0\"><img alt=\"Celebrazione in famiglia\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Feventi-3.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 transition-opacity duration-700 opacity-0\"><img alt=\"Allestimento evento speciale\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Feventi-4.jpg&amp;w=3840&amp;q=75\"/></div><button type=\"button\" aria-label=\"Immagine precedente\" class=\"absolute left-3 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 cursor-pointer items-center justify-center bg-black/30 transition-colors hover:bg-black/50\"><svg class=\"h-4 w-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M15 6L9 12L15 18\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" aria-label=\"Immagine successiva\" class=\"absolute right-3 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 cursor-pointer items-center justify-center bg-black/30 transition-colors hover:bg-black/50\"><svg class=\"h-4 w-4 text-white\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M9 6L15 12L9 18\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><div class=\"absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 items-center gap-1.5\"><button type=\"button\" aria-label=\"Vai all&#x27;immagine 1\" class=\"h-1.5 rounded-full transition-all duration-300 w-3 bg-white\"></button><button type=\"button\" aria-label=\"Vai all&#x27;immagine 2\" class=\"h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/50\"></button><button type=\"button\" aria-label=\"Vai all&#x27;immagine 3\" class=\"h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/50\"></button><button type=\"button\" aria-label=\"Vai all&#x27;immagine 4\" class=\"h-1.5 rounded-full transition-all duration-300 w-1.5 bg-white/50\"></button></div></div></div><div class=\"flex flex-col justify-center p-10 md:p-14\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Momenti speciali</span><h3 class=\"mt-3 font-serif text-3xl text-sol-bark\">Eventi privati</h3><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Il lago di Garda fa da sfondo, i vigneti incorniciano la scena, la veranda guarda verso l&#x27;acqua. Il Relais Del Sol è la cornice perfetta per eventi privati e celebrazioni speciali. Ogni dettaglio viene curato con la stessa cura che mettiamo in ogni aspetto del Relais.</p><div class=\"mt-6 grid grid-cols-2 gap-4\"><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Ospiti max</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Su richiesta</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Vista</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Lago e vigneti</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Allestimento</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Personalizzabile</p></div><div class=\"bg-sol-sand p-4\"><p class=\"font-sans text-[10px] uppercase tracking-widest text-sol-bark/40\">Sopralluogo</p><p class=\"mt-1 font-sans text-sm text-sol-bark\">Gratuito</p></div></div><p class=\"mt-4 font-sans text-xs italic text-sol-bark/50\">Contattaci per un preventivo personalizzato.</p><a class=\"mt-6 inline-flex items-center gap-2 font-sans text-sm uppercase tracking-wide text-sol-terracotta\" href=\"/contatti\">Richiedi informazioni →</a></div></article></div></div></section><section id=\"territorio\" class=\"bg-sol-sand py-24 md:py-32\"><div class=\"mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 md:grid-cols-2 md:px-16\"><div><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Intorno a noi</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">Lazise, il lago, e tutto il resto</h2><p class=\"mt-6 font-sans text-sm leading-relaxed text-sol-bark/70\">Pacengo di Lazise è uno dei punti più strategici del Lago di Garda. A pochi passi c&#x27;è tutto: il lago, i borghi medievali, le cantine, le terme. E quando vuoi staccare davvero, basta restare qui.</p><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">A soli 4 km sorge Lazise, uno dei borghi più belli del lago, con le sue mura medievali e il porto antico. A 3 km Bardolino, capitale del vino Bardolino DOC. A 20 km Verona, città di Romeo e Giulietta e patrimonio UNESCO.</p><div class=\"mt-8 flex flex-col gap-3\"><p class=\"flex items-center gap-3 font-sans text-sm text-sol-bark/70\"><span class=\"h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sol-terracotta\"></span>A 50m: fermata autobus</p><p class=\"flex items-center gap-3 font-sans text-sm text-sol-bark/70\"><span class=\"h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sol-terracotta\"></span>A 2 km: ospedale di Peschiera</p><p class=\"flex items-center gap-3 font-sans text-sm text-sol-bark/70\"><span class=\"h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sol-terracotta\"></span>A 4 km: stazione ferroviaria di Peschiera</p></div><div class=\"mt-6 flex flex-col gap-2\"><p class=\"font-sans text-sm text-sol-bark/70\"><span class=\"mr-2 text-sol-terracotta\">→</span>Noleggio bici convenzionato nelle vicinanze</p><p class=\"font-sans text-sm text-sol-bark/70\"><span class=\"mr-2 text-sol-terracotta\">→</span>Servizio transfer privato disponibile</p><p class=\"font-sans text-sm text-sol-bark/70\"><span class=\"mr-2 text-sol-terracotta\">→</span>Sconti convenzionati in ristoranti e negozi della zona</p></div></div><div class=\"grid grid-cols-2 gap-4\"><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Gardaland</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Parco divertimenti n°1 in Italia</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">1.8 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Movieland Park</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Parco tematico dedicato al cinema</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">200 m</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Caneva Aquapark</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Uno dei parchi acquatici più grandi d&#x27;Italia</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">200 m</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Parco Natura Viva</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Parco zoologico a Pastrengo</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">2 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Bardolino</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Vino DOC e lungolago</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">3 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Terme Villa dei Cedri</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Parco termale con alberi secolari</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">3 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Lazise</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Borgo medievale sul lago</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">4 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Parco Sigurtà</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Una delle oasi verdi più belle d&#x27;Italia</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">7 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Museo Nicolis</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Museo dell&#x27;auto e della meccanica</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">15 km</p></article><article class=\"bg-sol-cream p-5\"><p class=\"font-serif text-xl text-sol-bark\">Verona</p><p class=\"mt-0.5 font-sans text-xs text-sol-bark/50\">Patrimonio UNESCO — Romeo e Giulietta</p><p class=\"mt-3 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">20 km</p></article></div></div></section><section class=\"bg-sol-cream py-16 md:py-20\"><div class=\"mx-auto grid max-w-7xl grid-cols-1 items-start gap-16 px-6 md:grid-cols-2 md:px-16\"><div><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">La vita locale</span><h2 class=\"mt-4 font-serif text-3xl font-light text-sol-bark md:text-4xl\">I mercati settimanali del lago</h2><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Ogni giorno della settimana, in un paese diverso del lago, si tiene un mercato locale. Prodotti freschi, artigianato, il profumo del Lago di Garda. Un modo autentico di vivere il territorio.</p></div><div class=\"flex flex-col divide-y divide-sol-bark/10\"><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Lunedì</p><p class=\"font-sans text-sm text-sol-bark/70\">Peschiera del Garda, Colombare di Sirmione, Torri del Benaco</p></div><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Martedì</p><p class=\"font-sans text-sm text-sol-bark/70\">Castelnuovo del Garda, Desenzano</p></div><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Mercoledì</p><p class=\"font-sans text-sm text-sol-bark/70\">Lazise</p></div><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Giovedì</p><p class=\"font-sans text-sm text-sol-bark/70\">Bardolino, Bussolengo</p></div><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Venerdì</p><p class=\"font-sans text-sm text-sol-bark/70\">Garda</p></div><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Sabato</p><p class=\"font-sans text-sm text-sol-bark/70\">Pacengo, Valeggio, Malcesine</p></div><div class=\"flex items-start gap-4 py-3\"><p class=\"w-20 flex-shrink-0 pt-0.5 font-sans text-xs uppercase tracking-widest text-sol-terracotta\">Domenica</p><p class=\"font-sans text-sm text-sol-bark/70\">Rivoltella del Garda</p></div></div></div></section><section class=\"bg-sol-terracotta px-6 py-16 text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\"><span class=\"text-sol-cream/70\">Prenota il tuo soggiorno</span></span><h2 class=\"mt-3 font-serif text-3xl font-light text-sol-cream md:text-4xl\">Vivi tutto questo — a partire da Relais Del Sol</h2><div class=\"mt-8 flex flex-col items-center gap-4\"><a class=\"rounded-none bg-sol-cream px-8 py-4 font-sans text-sm uppercase tracking-wide text-sol-bark hover:bg-sol-sand\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Verifica disponibilità</a></div></section><!--$--><!--/$--></main><footer class=\"bg-sol-bark text-sol-cream/80\"><div class=\"mx-auto max-w-7xl px-4 py-16 md:px-8\"><div class=\"grid grid-cols-1 gap-12 md:grid-cols-3\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><img alt=\"Relais Del Sol\" loading=\"lazy\" width=\"80\" height=\"80\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-20 h-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75\"/><p class=\"font-serif text-2xl italic text-sol-cream\">Relais Del Sol</p></div><p class=\"font-sans text-sm text-sol-cream/80\">Dove la campagna tocca il lago</p><p class=\"font-sans text-sm leading-relaxed text-sol-cream/80\">Loc. Casa Antonia, 1 — 37017 Pacengo di Lazise (VR)</p><p class=\"font-sans text-sm\"><a class=\"text-sol-cream/80 transition-colors hover:text-sol-cream\" href=\"https://wa.me/390456490008\">+39 045 649 0008</a></p><p class=\"font-sans text-sm\"><a class=\"text-sol-cream/80 transition-colors hover:text-sol-cream\" href=\"mailto:info@relaisdelsol.com\">info@relaisdelsol.com</a></p></div><div class=\"space-y-4\"><p class=\"font-sans text-