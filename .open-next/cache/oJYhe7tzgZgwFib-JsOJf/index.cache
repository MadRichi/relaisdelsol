{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"it\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0bh8m..b~jckt.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0eqaxem3qj85e.js\"/><script src=\"/_next/static/chunks/0t~alnn~v6duj.js\" async=\"\"></script><script src=\"/_next/static/chunks/0.~ylj4ir16c3.js\" async=\"\"></script><script src=\"/_next/static/chunks/11i0b5~1.z993.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0.yhn5h0n6614.js\" async=\"\"></script><script src=\"/_next/static/chunks/0scs0g9f1_sv4.js\" async=\"\"></script><script src=\"/_next/static/chunks/0eewamb49pw7k.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ps5_aybo7288.js\" async=\"\"></script><script src=\"/_next/static/chunks/0bovixbu3jv9f.js\" async=\"\"></script><title>Agriturismo Relais del Sol | Lazise, Lago di Garda</title><meta name=\"description\" content=\"Agriturismo sul Lago di Garda a Pacengo di Lazise: camere eleganti, agricamping luxury, piscina, colazione e atmosfera autentica tra campagna e lago.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0u1vv8138-u_h.ico\" sizes=\"1206x1243\" type=\"image/x-icon\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LodgingBusiness\",\"name\":\"Agriturismo Relais del Sol\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Loc. Casa Antonia, 1\",\"addressLocality\":\"Pacengo di Lazise\",\"addressRegion\":\"VR\",\"postalCode\":\"37017\",\"addressCountry\":\"IT\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":45.5083,\"longitude\":10.7378},\"telephone\":\"+390456490008\",\"priceRange\":\"€€\",\"amenityFeature\":[\"Pool\",\"Breakfast\",\"WiFi\",\"Dog Friendly\",\"Lake View\"]}</script><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"bg-sol-cream text-sol-bark antialiased overflow-x-hidden\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-300\"><div class=\"mx-auto flex h-20 max-w-7xl items-center px-4 md:px-8\"><div class=\"w-10 md:hidden\"></div><a class=\"flex flex-1 items-center justify-center gap-2 transition-all duration-300 md:flex-none md:justify-start\" href=\"/\"><img alt=\"Relais Del Sol\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75\"/><span class=\"font-serif text-2xl italic text-sol-cream\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\">Relais Del Sol</span></a><nav class=\"ml-10 hidden items-center gap-7 md:flex\"><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/camere\">Camere</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/agricamping\">Agriglamping</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/esperienze\">Esperienze</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/prodotti\">Prodotti</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/chi-siamo\">Chi Siamo</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/contatti\">Contatti</a></nav><div class=\"ml-auto hidden md:block\"><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-sol-terracotta text-white border border-sol-terracotta hover:bg-sol-terracotta/90 h-9 px-4\" variant=\"primary\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota Ora</a></div><button type=\"button\" class=\"ml-auto inline-flex h-10 w-10 items-center justify-center md:hidden text-sol-cream\" aria-label=\"Apri menu\" aria-expanded=\"false\"><span class=\"sr-only\">Apri menu</span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M4 7H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M4 12H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M4 17H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path></svg></button></div></header><main><main><section class=\"relative min-h-screen h-screen w-full overflow-hidden\"><video autoPlay=\"\" muted=\"\" loop=\"\" playsInline=\"\" preload=\"auto\" poster=\"/images/hero.jpg\" class=\"absolute inset-0 w-full h-full object-cover\"><source src=\"/videos/hero.webm\" type=\"video/webm\"/><source src=\"/videos/hero.mp4\" type=\"video/mp4\"/></video><div class=\"absolute inset-0\" style=\"background:linear-gradient(to bottom, transparent 0%, rgba(92,74,50,0.7) 100%)\"></div><div class=\"absolute inset-x-0 bottom-36 md:bottom-44 px-6 md:px-16\"><div class=\"max-w-4xl\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\"><span class=\"text-sol-cream\">Pacengo di Lazise · Lago di Garda</span></span><h1 class=\"mt-3 whitespace-pre-line font-serif text-5xl font-light leading-tight text-sol-cream md:text-7xl\">Dove la campagna\ntocca il lago</h1><p class=\"mt-4 max-w-xl font-sans text-base text-sol-cream/80 md:text-lg\">Un angolo d&#x27;Italia dove il tempo rallenta, la campagna profuma di vino e ulivi, e il lago è sempre lì — a due passi, a fare da sfondo alla tua vacanza più bella.</p><div class=\"mt-8 flex flex-wrap items-center gap-4\"><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-sol-terracotta text-white border border-sol-terracotta hover:bg-sol-terracotta/90 h-11 px-5\" variant=\"primary\" href=\"/camere\">Scopri le Camere</a><a class=\"text-sol-cream border-sol-cream\" variant=\"ghost\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota Direttamente</a></div></div></div><div class=\"absolute bottom-24 left-1/2 -translate-x-1/2 text-sol-cream/60 animate-bounce\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M6 9L12 15L18 9\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div><div class=\"absolute bottom-0 left-0 right-0 bg-sol-bark/85 backdrop-blur-md\"><div class=\"flex flex-col md:flex-row\"><div class=\"flex flex-1 gap-0 divide-x divide-sol-cream/20\"><div class=\"relative flex flex-1 cursor-pointer flex-col px-6 py-5 transition-colors hover:bg-sol-cream/5\"><span class=\"mb-1 block font-sans text-[10px] uppercase tracking-[0.2em] text-sol-cream/50\">Arrivo</span><span class=\"font-sans text-sm font-light text-sol-cream/40\">Seleziona data</span></div><div class=\"relative flex flex-1 cursor-pointer flex-col px-6 py-5 transition-colors hover:bg-sol-cream/5\"><span class=\"mb-1 block font-sans text-[10px] uppercase tracking-[0.2em] text-sol-cream/50\">Partenza</span><span class=\"font-sans text-sm font-light text-sol-cream/40\">Seleziona data</span></div><div class=\"relative flex flex-1 select-none flex-col px-6 py-5 transition-colors hover:bg-sol-cream/5\"><span class=\"mb-1 block font-sans text-[10px] uppercase tracking-[0.2em] text-sol-cream/50\">Ospiti</span><div class=\"relative flex h-full w-full items-center\"><div class=\"absolute left-0 top-0 z-10 h-full w-1/2 cursor-pointer\"></div><div class=\"absolute right-0 top-0 z-10 h-full w-1/2 cursor-pointer\"></div><div class=\"pointer-events-none flex w-full items-center justify-between\"><span class=\"font-serif text-lg text-sol-cream/50\">−</span><span class=\"font-sans text-sm font-light text-sol-cream\">2<!-- --> <!-- -->ospiti</span><span class=\"font-serif text-lg text-sol-cream/50\">+</span></div></div></div></div><button type=\"button\" class=\"w-full whitespace-nowrap bg-sol-terracotta px-8 py-4 font-sans text-xs uppercase tracking-[0.2em] text-white transition-colors hover:bg-sol-terracotta/90 md:w-64 md:py-5\">Verifica disponibilità</button></div></div></section><section class=\"bg-sol-sand py-24 md:py-32\"><div class=\"mx-auto max-w-2xl px-6 text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Perché Relais del Sol</span><div class=\"flex justify-center mt-4\"><svg width=\"80\" height=\"24\" viewBox=\"0 0 80 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"text-sol-olive\" role=\"presentation\" aria-hidden=\"true\"><path d=\"M2 12H78\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M30 12C30 9.2 32.2 7 35 7\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M50 12C50 14.8 47.8 17 45 17\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M38 11C39.5 8.8 41.5 8.8 43 11C41.5 12.5 39.5 12.5 38 11Z\" fill=\"currentColor\"></path></svg></div><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">Non un hotel. Un posto dove tornare.</h2></div><div class=\"mx-auto mt-16 grid max-w-7xl grid-cols-1 items-stretch gap-12 px-6 md:grid-cols-3 md:px-16\"><article class=\"h-full flex flex-col\"><h3 class=\"font-serif text-3xl text-sol-bark/70 mb-3\">Il lago a due passi</h3><p class=\"mt-auto font-sans text-sm leading-relaxed text-sol-bark/70\">Pacengo di Lazise è uno degli angoli più autentici del Lago di Garda. Qui il turismo di massa si ferma, e inizia la vera vacanza.</p></article><article class=\"h-full flex flex-col\"><h3 class=\"font-serif text-3xl text-sol-bark/70 mb-3\">Ospitalità di famiglia</h3><p class=\"mt-auto font-sans text-sm leading-relaxed text-sol-bark/70\">Una grande cura ha caraterizzato la scelta di ogni tessuto, ogni profumo, ogni dettaglio. Non per fare un albergo, ma per condividere il posto dove vivono.</p></article><article class=\"h-full flex flex-col\"><h3 class=\"font-serif text-3xl text-sol-bark/70 mb-3\">Natura e autenticità</h3><p class=\"mt-auto font-sans text-sm leading-relaxed text-sol-bark/70\">Vino, olio, prodotti della terra. La colazione con le marmellate di casa. Il benessere della natura in ogni dettaglio.</p></article></div></section><section class=\"bg-sol-cream py-24 md:py-32\"><div class=\"mx-auto max-w-2xl px-6 text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Dove dormire</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">Camere pensate per farti stare bene</h2><p class=\"mt-4 font-sans text-base text-sol-bark/70\">Ogni stanza è diversa. Tutte hanno una cosa in comune: ti faranno venire voglia di restare un giorno in più.</p></div><div class=\"mx-auto mt-16 flex max-w-7xl flex-col gap-8 px-6 md:px-16\"><a class=\"block\" href=\"/camere/camera-standard\"><article class=\"bg-sol-mist transition-transform duration-300 hover:-translate-y-2 cursor-pointer\"><div class=\"grid grid-cols-1 md:grid-cols-[55%_45%]\"><div class=\"group relative w-full overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-[320px]\"><div class=\"absolute left-4 top-4 z-10\"><span class=\"inline-flex items-center bg-sol-terracotta/90 px-3 py-1 font-sans text-xs uppercase tracking-wider text-white rounded-none\">Romantica</span></div><img alt=\"Camera Standard con tessuti naturali e luce del mattino\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fstandard-1.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col justify-center p-8 md:p-12\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">La tua stanza</span><h3 class=\"mt-2 font-serif text-2xl text-sol-bark md:text-3xl\">Camera Standard</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Chiudi la porta, rallenti il respiro e lasci che il silenzio della campagna accompagni la tua sera.</p><p class=\"mt-4 font-sans text-xs text-sol-bark/50\">Atmosfera provenzale e country-romantica · Materiali naturali e curati · Ideale per una fuga di coppia</p></div></div></article></a><a class=\"block\" href=\"/camere/camera-balcone-vista-lago\"><article class=\"bg-sol-mist transition-transform duration-300 hover:-translate-y-2 cursor-pointer\"><div class=\"grid grid-cols-1 md:grid-cols-[55%_45%]\"><div class=\"group relative w-full overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-[320px]\"><div class=\"absolute left-4 top-4 z-10\"><span class=\"inline-flex items-center bg-sol-terracotta/90 px-3 py-1 font-sans text-xs uppercase tracking-wider text-white rounded-none\">Vista Lago</span></div><img alt=\"Camera con balcone e vista aperta sul Lago di Garda\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fvista-lago-1.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col justify-center p-8 md:p-12\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">La tua stanza</span><h3 class=\"mt-2 font-serif text-2xl text-sol-bark md:text-3xl\">Camera con Balcone Vista Lago</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Apri la finestra, fai un passo sul balcone e davanti a te c&#x27;e il Lago di Garda, calmo e luminoso.</p><p class=\"mt-4 font-sans text-xs text-sol-bark/50\">Balcone privato affacciato sul Lago di Garda · Luce naturale per tutta la giornata · Perfetta per soggiorni romantici</p></div></div></article></a><a class=\"block\" href=\"/camere/camera-angolo-cottura-veranda\"><article class=\"bg-sol-mist transition-transform duration-300 hover:-translate-y-2 cursor-pointer\"><div class=\"grid grid-cols-1 md:grid-cols-[55%_45%]\"><div class=\"group relative w-full overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-[320px]\"><div class=\"absolute left-4 top-4 z-10\"><span class=\"inline-flex items-center bg-sol-terracotta/90 px-3 py-1 font-sans text-xs uppercase tracking-wider text-white rounded-none\">Con Cucina</span></div><img alt=\"Camera con angolo cottura in stile naturale e accogliente\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Frooms%2Fcucina-veranda-1.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"flex flex-col justify-center p-8 md:p-12\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">La tua stanza</span><h3 class=\"mt-2 font-serif text-2xl text-sol-bark md:text-3xl\">Camera con Angolo Cottura e Veranda</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Hai i tuoi tempi: cucini qualcosa di semplice, poi ti siedi in veranda mentre la sera profuma di lago e campagna.</p><p class=\"mt-4 font-sans text-xs text-sol-bark/50\">Angolo cottura funzionale · Veranda privata per colazioni e relax · Ideale per soggiorni lunghi o in famiglia</p></div></div></article></a></div><div class=\"mt-12 flex justify-center\"><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-transparent text-sol-terracotta border border-sol-terracotta hover:bg-sol-terracotta/10 h-11 px-5\" variant=\"outline\" href=\"/camere\">Vedi tutte le camere</a></div></section><section class=\"bg-sol-cream py-24 md:py-32\"><div class=\"mx-auto max-w-7xl px-6 md:px-16\"><div class=\"mx-auto mb-16 max-w-2xl text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">La tua esperienza</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">Tutto quello che rende speciale il soggiorno</h2></div><div class=\"grid grid-cols-1 gap-8 items-stretch md:grid-cols-3\"><a class=\"block\" href=\"/esperienze#colazione\"><article class=\"group h-full flex flex-col overflow-hidden bg-sol-mist transition-transform duration-300 hover:-translate-y-2 cursor-pointer\"><div class=\"relative aspect-[4/3] overflow-hidden\"><img alt=\"Colazione con prodotti locali e fatti in casa\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fcolazione.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"pt-6 px-6 pb-8 flex flex-col flex-1\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Ogni mattina</span><h3 class=\"mt-2 font-serif text-2xl text-sol-bark\">Colazione con i sapori di casa</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Marmellate fatte in casa, formaggi locali, pane fresco e i prodotti della nostra terra. La colazione a Relais del Sol è il momento in cui capisci che questo posto è diverso.</p><span class=\"mt-auto pt-4 inline-flex font-sans text-xs uppercase tracking-wide text-sol-terracotta\">Scopri →</span></div></article></a><a class=\"block\" href=\"/esperienze#piscina\"><article class=\"group h-full flex flex-col overflow-hidden bg-sol-mist transition-transform duration-300 hover:-translate-y-2 cursor-pointer\"><div class=\"relative aspect-[4/3] overflow-hidden\"><img alt=\"Parco verde e piscina a sfioro\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Fpiscina.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"pt-6 px-6 pb-8 flex flex-col flex-1\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Relax</span><h3 class=\"mt-2 font-serif text-2xl text-sol-bark\">Parco e piscina a sfioro</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Un grande parco verde dove il tempo si dilata. La piscina a sfioro guarda verso il lago — ci sono pomeriggi qui che non dimenticherai.</p><span class=\"mt-auto pt-4 inline-flex font-sans text-xs uppercase tracking-wide text-sol-terracotta\">Scopri →</span></div></article></a><a class=\"block\" href=\"/esperienze#eventi\"><article class=\"group h-full flex flex-col overflow-hidden bg-sol-mist transition-transform duration-300 hover:-translate-y-2 cursor-pointer\"><div class=\"relative aspect-[4/3] overflow-hidden\"><img alt=\"Allestimento per matrimonio o evento privato\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fservices%2Feventi.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"pt-6 px-6 pb-8 flex flex-col flex-1\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Momenti speciali</span><h3 class=\"mt-2 font-serif text-2xl text-sol-bark\">Matrimoni ed eventi privati</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">La cornice naturale di Relais del Sol diventa lo sfondo perfetto per il tuo evento. Eventi privati e celebrazioni speciali: ci occupiamo di ogni dettaglio.</p><span class=\"mt-auto pt-4 inline-flex font-sans text-xs uppercase tracking-wide text-sol-terracotta\">Scopri →</span></div></article></a></div></div></section><section class=\"bg-sol-terracotta py-24 md:py-32\"><div class=\"mx-auto max-w-7xl px-6 md:px-16\"><div class=\"mx-auto mb-16 max-w-2xl text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\"><span class=\"text-sol-cream/70\">Prenota direttamente</span></span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-cream md:text-5xl\">Il prezzo migliore è sempre sul nostro sito</h2></div><div class=\"grid grid-cols-1 gap-12 md:grid-cols-3\"><article class=\"border-t border-sol-cream/30 pt-8\"><p class=\"font-serif text-5xl font-light text-sol-cream/20\">01</p><h3 class=\"mt-2 font-serif text-xl text-sol-cream\">Prezzo garantito</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-cream/80\">Prenoti direttamente da noi e hai la certezza di pagare il prezzo più basso disponibile. Nessun sito intermedio può batterlo.</p></article><article class=\"border-t border-sol-cream/30 pt-8\"><p class=\"font-serif text-5xl font-light text-sol-cream/20\">02</p><h3 class=\"mt-2 font-serif text-xl text-sol-cream\">Regalo di benvenuto</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-cream/80\">Chi prenota sul sito ufficiale riceve in omaggio un regalo esclusivo.</p></article><article class=\"border-t border-sol-cream/30 pt-8\"><p class=\"font-serif text-5xl font-light text-sol-cream/20\">03</p><h3 class=\"mt-2 font-serif text-xl text-sol-cream\">Flessibilità</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-cream/80\">Condizioni di cancellazione più vantaggiose rispetto alle OTA. Perché preferiamo un ospite sereno a una prenotazione forzata.</p></article></div><div class=\"mt-16 text-center\"><a class=\"border-sol-cream text-sol-cream hover:bg-sol-cream/10\" variant=\"ghost\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota Ora — Sito Ufficiale</a><p class=\"mt-4 text-center font-sans text-xs italic text-sol-cream/50\">Nessuna commissione. Nessun intermediario. Solo noi e te.</p></div></div></section><section class=\"bg-sol-sand py-24 md:py-32\"><div class=\"mx-auto grid max-w-7xl grid-cols-1 gap-12 px-6 md:grid-cols-2 md:gap-0 md:px-16\"><div class=\"flex flex-col justify-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Dove siamo</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">A due passi dal lago, lontano dal caos</h2><p class=\"mt-6 font-sans text-sm leading-relaxed text-sol-bark/70\">Pacengo di Lazise è una delle frazioni più tranquille della sponda veronese del Lago di Garda. Siamo a 5 minuti a piedi dall&#x27;acqua, a 10 minuti da Lazise, a 20 minuti da Bardolino.</p><div class=\"mt-8 flex flex-col gap-3\"><div class=\"flex items-center gap-3\"><span class=\"h-1.5 w-1.5 rounded-full bg-sol-terracotta\"></span><p class=\"font-sans text-sm text-sol-bark/70\">Loc. Casa Antonia, 1 — 37017 Pacengo di Lazise (VR)</p></div><div class=\"flex items-center gap-3\"><span class=\"h-1.5 w-1.5 rounded-full bg-sol-terracotta\"></span><p class=\"font-sans text-sm text-sol-bark/70\">5 min a piedi dal lago</p></div><div class=\"flex items-center gap-3\"><span class=\"h-1.5 w-1.5 rounded-full bg-sol-terracotta\"></span><p class=\"font-sans text-sm text-sol-bark/70\">10 min da Lazise, 20 min da Bardolino</p></div></div><div class=\"mt-8 flex flex-wrap gap-4\"><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-sol-terracotta text-white border border-sol-terracotta hover:bg-sol-terracotta/90 h-11 px-5\" variant=\"primary\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.google.com/maps/dir/?api=1&amp;destination=Loc.+Casa+Antonia+1+Pacengo+di+Lazise\">Ottieni indicazioni</a><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-transparent text-sol-terracotta border border-sol-terracotta hover:bg-sol-terracotta/10 h-11 px-5\" variant=\"outline\" href=\"/esperienze#territorio\">Scopri la zona</a></div></div><div class=\"min-h-[400px] overflow-hidden rounded-none md:min-h-[500px]\"><iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d669.1668086373817!2d10.721606350999053!3d45.4714915715088!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4781e94ba76f9b2f%3A0xfec8bc838a99fc43!2sCa&#x27;%20del%20Sol!5e1!3m2!1sit!2sit!4v1776344145649!5m2!1sit!2sit\" width=\"100%\" height=\"100%\" style=\"border:0\" allowFullScreen=\"\" loading=\"lazy\" referrerPolicy=\"no-referrer-when-downgrade\" title=\"Posizione Agriturismo Relais del Sol\" class=\"min-h-[400px] w-full md:min-h-[500px]\"></iframe></div></div></section><section class=\"bg-sol-bark py-20 md:py-24\"><div class=\"mx-auto max-w-3xl px-6 text-center\"><h2 class=\"font-serif text-4xl font-light text-sol-cream md:text-5xl\">Pronto a vivere Relais del Sol?</h2><p class=\"mt-4 font-sans text-sm text-sol-cream/70\">Prenota direttamente sul sito ufficiale. Il prezzo migliore è sempre qui.</p><a class=\"mt-8 inline-flex rounded-none bg-sol-terracotta px-10 py-4 font-sans text-sm uppercase tracking-wide text-white transition-colors hover:bg-sol-terracotta/90\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota Ora</a><p class=\"mt-4 font-sans text-xs text-sol-cream/40\">Oppure chiamaci:<!-- --> <a class=\"text-sol-cream/60 transition-colors hover:text-sol-cream\" href=\"tel:+390456490008\">+39 045 649 0008</a></p></div></section></main><!--$--><!--/$--></main><footer class=\"bg-sol-bark text-sol-cream/80\"><div class=\"mx-auto max-w-7xl px-4 py-16 md:px-8\"><div class=\"grid grid-cols-1 gap-12 md:grid-cols-3\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><img alt=\"Relais Del Sol\" loading=\"lazy\" width=\"80\" height=\"80\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-20 h-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75\"/><p class=\"font-serif text-2xl italic text-sol-cream\">Relais Del Sol</p></div><p class=\"font-sans text-sm text-sol-cream/80\">Dove la campagna tocca il lago</p><p class=\"font-sans text-sm leading-relaxed text-sol-cream/80\">Loc. Casa Antonia, 1 — 37017 Pacengo di Lazise (VR)</p><p class=\"font-sans text-sm\"><a class=\"text-sol-cream/80 transition-colors hover:text-sol-cream\" href=\"https://wa.me/390456490008\">+39 045 649 0008<