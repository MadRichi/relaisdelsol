one per l&#x27;ospitalità autentica e un angolo di campagna veneta sul Lago di Garda.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0u1vv8138-u_h.ico\" sizes=\"1206x1243\" type=\"image/x-icon\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"LodgingBusiness\",\"name\":\"Agriturismo Relais del Sol\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Loc. Casa Antonia, 1\",\"addressLocality\":\"Pacengo di Lazise\",\"addressRegion\":\"VR\",\"postalCode\":\"37017\",\"addressCountry\":\"IT\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":45.5083,\"longitude\":10.7378},\"telephone\":\"+390456490008\",\"priceRange\":\"€€\",\"amenityFeature\":[\"Pool\",\"Breakfast\",\"WiFi\",\"Dog Friendly\",\"Lake View\"]}</script><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"bg-sol-cream text-sol-bark antialiased overflow-x-hidden\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 transition-all duration-300\"><div class=\"mx-auto flex h-20 max-w-7xl items-center px-4 md:px-8\"><div class=\"w-10 md:hidden\"></div><a class=\"flex flex-1 items-center justify-center gap-2 transition-all duration-300 md:flex-none md:justify-start\" href=\"/\"><img alt=\"Relais Del Sol\" loading=\"lazy\" width=\"36\" height=\"36\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75\"/><span class=\"font-serif text-2xl italic text-sol-cream\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\">Relais Del Sol</span></a><nav class=\"ml-10 hidden items-center gap-7 md:flex\"><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/camere\">Camere</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/agricamping\">Agriglamping</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/esperienze\">Esperienze</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/prodotti\">Prodotti</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/chi-siamo\">Chi Siamo</a><a class=\"font-sans text-sm uppercase tracking-wide transition-colors text-sol-cream hover:text-sol-cream/70 font-medium\" style=\"text-shadow:0 1px 3px rgba(0,0,0,0.4)\" href=\"/contatti\">Contatti</a></nav><div class=\"ml-auto hidden md:block\"><a class=\"inline-flex items-center justify-center rounded-none font-sans text-sm uppercase tracking-wide transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-sol-bark disabled:pointer-events-none disabled:opacity-60 bg-sol-terracotta text-white border border-sol-terracotta hover:bg-sol-terracotta/90 h-9 px-4\" variant=\"primary\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota Ora</a></div><button type=\"button\" class=\"ml-auto inline-flex h-10 w-10 items-center justify-center md:hidden text-sol-cream\" aria-label=\"Apri menu\" aria-expanded=\"false\"><span class=\"sr-only\">Apri menu</span><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M4 7H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M4 12H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path><path d=\"M4 17H20\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path></svg></button></div></header><main><section class=\"relative h-[70vh] min-h-[500px] overflow-hidden\"><img alt=\"La storia del Relais Del Sol\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Ffamily.jpg&amp;w=3840&amp;q=75\"/><div class=\"absolute inset-0 bg-gradient-to-b from-transparent to-sol-bark/70\"></div><div class=\"absolute bottom-12 left-6 md:left-16\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\"><span class=\"text-sol-cream\">La nostra storia</span></span><h1 class=\"mt-3 font-serif text-5xl font-light text-sol-cream md:text-6xl\">Chi Siamo</h1><p class=\"mt-2 font-sans text-lg text-sol-cream/80\">Una famiglia, un posto, una scelta.</p></div></section><section class=\"bg-sol-cream py-24 md:py-32\"><div class=\"mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 md:grid-cols-2 md:px-16\"><div><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Le nostre radici</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">Un posto che esiste perche qualcuno lo ha scelto</h2><p class=\"mt-6 font-sans text-sm leading-relaxed text-sol-bark/70\">Il Relais Del Sol non è nato da un progetto imprenditoriale. È nato dall&#x27;amore per questo angolo del Lago di Garda, dalla volonta di condividere qualcosa di autentico con chi arriva da lontano cercando qualcosa di diverso.</p><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Pacengo di Lazise, a pochi passi dal Lago di Garda, è il posto dove la nostra famiglia ha scelto di mettere radici. E ogni anno, da questa terra, nascono i prodotti, le esperienze e l&#x27;accoglienza che rendono ogni soggiorno diverso dagli altri.</p><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Accogliamo ogni ospite con la stessa cura con cui si accoglie qualcuno a casa propria. Perche in fondo, questo posto è casa - e quando ci si sente a casa, si torna sempre.</p></div><div class=\"relative bg-sol-sand p-10 md:p-14\"><p class=\"pointer-events-none absolute top-4 left-6 font-serif text-8xl leading-none text-sol-terracotta/20\">“</p><blockquote class=\"relative z-10 font-serif text-xl leading-relaxed italic text-sol-bark/80\">Abbiamo scelto di aprire le porte di casa nostra perché crediamo che la vera ospitalità non si insegna - si sente.</blockquote><p class=\"mt-6 font-sans text-xs uppercase tracking-widest text-sol-bark/40\">- La nostra famiglia</p></div></div></section><section class=\"bg-sol-sand py-24 md:py-32\"><div class=\"mx-auto max-w-7xl px-6 md:px-16\"><header class=\"mx-auto mb-16 max-w-2xl text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Quello in cui crediamo</span><h2 class=\"mt-4 font-serif text-4xl font-light text-sol-bark md:text-5xl\">I valori che guidano ogni scelta</h2></header><div class=\"grid grid-cols-1 gap-8 md:grid-cols-2\"><article class=\"bg-sol-cream p-8\"><p class=\"font-serif text-5xl font-light text-sol-terracotta/30\">01</p><h3 class=\"mt-2 font-serif text-xl text-sol-bark\">Autenticita</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Niente qui è costruito per sembrare quello che non è. I prodotti vengono dalla nostra terra, le ricette dalla nostra tradizione, l&#x27;accoglienza dal nostro carattere.</p></article><article class=\"bg-sol-cream p-8\"><p class=\"font-serif text-5xl font-light text-sol-terracotta/30\">02</p><h3 class=\"mt-2 font-serif text-xl text-sol-bark\">Cura del dettaglio</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Ogni tessuto scelto, ogni profumo nella stanza, ogni ingrediente sulla tavola della colazione. La qualita non e un obiettivo - e un&#x27;abitudine.</p></article><article class=\"bg-sol-cream p-8\"><p class=\"font-serif text-5xl font-light text-sol-terracotta/30\">03</p><h3 class=\"mt-2 font-serif text-xl text-sol-bark\">Rispetto per la natura</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Viviamo in un posto straordinario e lo trattiamo con rispetto. Prodotti ecocompatibili, filiera corta, stagionalita: scelte concrete, non slogan.</p></article><article class=\"bg-sol-cream p-8\"><p class=\"font-serif text-5xl font-light text-sol-terracotta/30\">04</p><h3 class=\"mt-2 font-serif text-xl text-sol-bark\">Ospitalita vera</h3><p class=\"mt-3 font-sans text-sm leading-relaxed text-sol-bark/70\">Non vogliamo ospiti soddisfatti. Vogliamo ospiti che tornano. C&#x27;è differenza - e si sente dal primo momento in cui si varca il cancello.</p></article></div></div></section><section class=\"bg-sol-cream py-24 md:py-32\"><div class=\"mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 md:grid-cols-2 md:px-16\"><div class=\"relative min-h-[500px] overflow-hidden\"><img alt=\"Il Relais Del Sol a Pacengo di Lazise\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fhero.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fhero.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fhero.jpg&amp;w=3840&amp;q=75\"/></div><div><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\">Il nostro posto</span><h2 class=\"mt-4 font-serif text-3xl font-light text-sol-bark md:text-4xl\">Pacengo di Lazise - dove tutto e vicino e il rumore e lontano</h2><p class=\"mt-6 font-sans text-sm leading-relaxed text-sol-bark/70\">Il Relais sorge tra i vigneti e gli oliveti della sponda veronese del Lago di Garda. A cinque minuti a piedi c&#x27;e il lago. A quattro chilometri il borgo medievale di Lazise. Gardaland è a meno di due chilometri.</p><p class=\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\">Ma la cosa più bella di questo posto è che puoi anche non andare da nessuna parte. Il parco, la piscina, la veranda, il rumore del lago la mattina - a volte la vacanza migliore è quella che non ti porta lontano.</p><a class=\"mt-8\" variant=\"outline\" href=\"/esperienze\">Scopri le esperienze</a></div></div></section><section class=\"bg-sol-mist px-6 py-8\"><div class=\"mx-auto max-w-7xl\"><p class=\"text-center font-sans text-xs italic text-sol-bark/30\">- Sezione in aggiornamento. Contenuti definitivi in arrivo. -</p></div></section><section class=\"bg-sol-terracotta px-6 py-16 text-center\"><span class=\"font-sans text-xs uppercase tracking-widest text-sol-olive\"><span class=\"text-sol-cream/70\">Vieni a trovarci</span></span><h2 class=\"mt-3 font-serif text-3xl font-light text-sol-cream md:text-4xl\">La storia più bella è quella che si vive di persona</h2><div class=\"mt-8 flex justify-center\"><a class=\"rounded-none bg-sol-cream px-8 py-4 font-sans text-sm uppercase tracking-wide text-sol-bark hover:bg-sol-sand\" href=\"https://be.bookingexpert.it/book/simple/noavail?hotel=42837&amp;layout=14194&amp;lang=it&amp;currency=EUR\">Prenota il tuo soggiorno</a></div></section><!--$--><!--/$--></main><footer class=\"bg-sol-bark text-sol-cream/80\"><div class=\"mx-auto max-w-7xl px-4 py-16 md:px-8\"><div class=\"grid grid-cols-1 gap-12 md:grid-cols-3\"><div class=\"space-y-4\"><div class=\"flex items-center gap-3\"><img alt=\"Relais Del Sol\" loading=\"lazy\" width=\"80\" height=\"80\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-20 h-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo.png&amp;w=256&amp;q=75\"/><p class=\"font-serif text-2xl italic text-sol-cream\">Relais Del Sol</p></div><p class=\"font-sans text-sm text-sol-cream/80\">Dove la campagna tocca il lago</p><p class=\"font-sans text-sm leading-relaxed text-sol-cream/80\">Loc. Casa Antonia, 1 — 37017 Pacengo di Lazise (VR)</p><p class=\"font-sans text-sm\"><a class=\"text-sol-cream/80 transition-colors hover:text-sol-cream\" href=\"https://wa.me/390456490008\">+39 045 649 0008</a></p><p class=\"font-sans text-sm\"><a class=\"text-sol-cream/80 transition-colors hover:text-sol-cream\" href=\"mailto:info@relaisdelsol.com\">info@relaisdelsol.com</a></p></div><div class=\"space-y-4\"><p class=\"font-sans text-xs uppercase tracking-widest text-sol-cream\">Esplora</p><nav class=\"flex flex-col gap-2\"><a class=\"font-sans text-sm text-sol-cream/70 transition-colors hover:text-sol-cream\" href=\"/\">Home</a><a class=\"font-sans text-sm text-sol-cream/70 transition-colors hover:text-sol-cream\" href=\"/camere\">Camere</a><a class=\"font-sans text-sm text-sol-cream/70 transition-colors hove