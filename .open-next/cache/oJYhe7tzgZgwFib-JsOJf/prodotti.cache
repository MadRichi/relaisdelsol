ve\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-sol-cream\",\"children\":\"Dalla nostra terra\"}]}],[\"$\",\"h1\",null,{\"className\":\"mt-3 font-serif text-5xl font-light text-sol-cream md:text-6xl\",\"children\":\"I Prodotti del Relais\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 max-w-lg font-sans text-base text-sol-cream/80\",\"children\":\"Vino, olio extravergine. Puoi degustarli in struttura e portarteli a casa.\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"bg-sol-cream py-16 md:py-20\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-6 text-center\",\"children\":[\"$\",\"p\",null,{\"className\":\"font-sans text-base leading-relaxed text-sol-bark/70\",\"children\":\"Nella saletta vicino alla reception, tra le bottiglie allineate sugli scaffali, si racconta la storia di questa terra. Il vino e l'olio nascono qui, a Pacengo di Lazise, tra i vigneti e gli oliveti che circondano il Relais. Puoi degustarli durante il tuo soggiorno e portarli a casa come ricordo di un posto che non si dimentica.\"}]}]}],[\"$\",\"section\",null,{\"className\":\"bg-sol-sand py-24 md:py-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-6 md:px-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-sans text-xs uppercase tracking-widest text-sol-olive\",\"children\":\"La nostra produzione\"}],[\"$\",\"h2\",null,{\"className\":\"mt-4 mb-16 font-serif text-4xl font-light text-sol-bark md:text-5xl\",\"children\":\"Cosa produciamo\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-20\",\"children\":[[\"$\",\"article\",null,{\"className\":\"grid grid-cols-1 gap-0 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative min-h-[400px] overflow-hidden\",\"children\":[\"$\",\"$L2\",null,{\"src\":\"/images/prodotti/prodotti-4.jpg\",\"alt\":\"Vino del Relais Del Sol\",\"fill\":true,\"className\":\"object-cover\"}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center bg-sol-cream p-10 md:p-14\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-sans text-xs uppercase tracking-widest text-sol-olive\",\"children\":\"Dalla vigna\"}],[\"$\",\"h3\",null,{\"className\":\"mt-3 font-serif text-3xl text-sol-bark\",\"children\":\"Vino — Rosso, Bianco e Rosé\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 font-sans text-sm leading-relaxed text-sol-bark/70\",\"children\":\"I vigneti del Relais crescono sulle colline che guardano il lago. Il risultato sono vini che parlano di questo territorio: il rosso strutturato delle colline veronesi, il bianco fresco e minerale, il rosé elegante per le serate estive. Tutti disponibili in struttura, da assaporare in veranda o da portare a casa.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"bg-sol-sand px-4 py-2 font-sans text-xs uppercase tracking-wide text-sol-bark/70\",\"children\":\"Vino Rosso\"}],[\"$\",\"span\",null,{\"className\":\"bg-sol-sand px-4 py-2 font-sans text-xs uppercase tracking-wide text-sol-bark/70\",\"children\":\"Vino Bianco\"}],[\"$\",\"span\",null,{\"className\":\"bg-sol-sand px-4 py-2 font-sans text-xs uppercase tracking-wide text-sol-bark/70\",\"children\":\"Vino Rosé\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 font-sans text-xs italic text-sol-bark/40\",\"children\":\"Disponibile in struttura — assortimento soggetto a stagionalità\"}]]}]]}],[\"$\",\"article\",null,{\"className\":\"grid grid-cols-1 gap-0 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"order-1 flex flex-col justify-center bg-sol-cream p-10 md:p-14\",\"children\":[\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\"]}],\"$L8\"]}]]}]]}]}],\"$L9\",\"$La\",\"$Lb\"],null,\"$Lc\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"oJYhe7tzgZgwFib-JsOJf\"}\n3:[\"$\",\"span\",null,{\"className\":\"font-sans text-xs uppercase tracking-widest text-sol-olive\",\"child